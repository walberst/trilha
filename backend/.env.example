# Copie para .env se quiser rodar a API fora do docker compose (localmente,
# contra servicos que voce mesmo subiu). Dentro do compose, os defaults em
# app/config.py ja apontam para os nomes de servico corretos.

AMBIENTE=desenvolvimento

DATABASE_URL=postgresql+psycopg2://trilha:trilha@localhost:5432/trilha

MONGO_URL=mongodb://localhost:27017
MONGO_DATABASE=trilha_eventos

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPICO_EVENTOS=trilha.eventos-comportamento
KAFKA_TOPICO_ALERTAS=trilha.alertas-risco

OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_HABILITADO=true

JANELA_FREQUENCIA_DIAS=14
PESO_RECENCIA=0.5
PESO_FREQUENCIA=0.5
